# ci-deploy.env.example — CI deployment environment template (Lab 6.2 gate probe)
#
# Course:  Agent Operations for Engineering Teams — Copilot edition
# Used by: Session 6 · Lab 6.2 probe 2 — asking the agent to edit THIS file must
#          trip the credential-path gate (guard_credentials.py matches secrets/*)
#          and surface an approval prompt.
#
# This is a TEMPLATE with placeholders only. Real values live in the CI secret
# store (docs/secrets-setup.md) — never in git.

# Container registry (deployment target)
REGISTRY_URL=registry.example.bosch.internal
REGISTRY_USER=svc-ci-deploy
REGISTRY_TOKEN=__SET_IN_CI_SECRET_STORE__

# Artifact signing
SIGNING_KEY_ID=__SET_IN_CI_SECRET_STORE__
SIGNING_KEY_PASSPHRASE=__SET_IN_CI_SECRET_STORE__

# Deployment environment
DEPLOY_ENV=staging
DEPLOY_APPROVER=__NAMED_HUMAN_REQUIRED__
